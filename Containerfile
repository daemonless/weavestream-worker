ARG BASE_VERSION=latest
FROM ghcr.io/daemonless/base-exec:${BASE_VERSION} AS builder

ARG FREEBSD_ARCH=amd64
ARG PACKAGES="node24 npm-node24 prisma-engines ca_root_nss FreeBSD-clang FreeBSD-lld gmake pkgconf"
ARG UPSTREAM_URL="https://api.github.com/repos/Weavestream/Weavestream/releases/latest"
ARG UPSTREAM_JQ=".tag_name"

ENV PNPM_HOME="/pnpm" \
    PATH="/pnpm:$PATH" \
    COREPACK_ENABLE_DOWNLOAD_PROMPT=0 \
    PRISMA_SCHEMA_ENGINE_BINARY="/usr/local/libexec/prisma-engines/schema-engine" \
    PRISMA_QUERY_ENGINE_LIBRARY="/usr/local/libexec/prisma-engines/libquery_engine.so"

RUN pkg update && pkg install -y ${PACKAGES} && \
    pkg clean -ay && \
    rm -rf /var/cache/pkg/* /var/db/pkg/repos/* && \
    VERSION=$(fetch -qo - "${UPSTREAM_URL}" | jq -r "${UPSTREAM_JQ}" | sed 's/^v//') && \
    if [ -z "${VERSION}" ] || [ "${VERSION}" = "null" ]; then \
        VERSION=$(fetch -v -o /dev/null "https://github.com/Weavestream/Weavestream/releases/latest" 2>&1 | sed -n 's|^.*redirect to .*/releases/tag/v\{0,1\}||p' | head -1); \
    fi && \
    if [ -z "${VERSION}" ]; then echo "ERROR: could not resolve release version" >&2; exit 1; fi && \
    echo "Building Weavestream Worker ${VERSION}" && \
    mkdir -p /repo && \
    fetch -qo /tmp/weavestream.tar.gz "https://github.com/Weavestream/Weavestream/archive/refs/tags/v${VERSION}.tar.gz" && \
    tar -xzf /tmp/weavestream.tar.gz -C /repo --strip-components=1 && \
    rm /tmp/weavestream.tar.gz && \
    mkdir -p /app && \
    echo "${VERSION}" > /app/version

WORKDIR /repo

# Upstream lists every desktop OS under supportedArchitectures, so pnpm fetches
# all of their native binaries: only this platform's are wanted.
RUN corepack enable && \
    sed -i '' '/^supportedArchitectures:/,/^allowBuilds:/{/^allowBuilds:/!d;}' pnpm-workspace.yaml && \
    printf 'supportedArchitectures:\n  os:\n    - freebsd\n  cpu:\n    - %s\n' "$([ "${FREEBSD_ARCH}" = aarch64 ] && echo arm64 || echo x64)" >> pnpm-workspace.yaml && \
    sed -i '' 's/argon2: true/argon2: true\n  esbuild: true/' pnpm-workspace.yaml && \
    sed -i '' 's/"@prisma\/client": "\^5.22.0"/"@prisma\/client": "6.19.0"/' packages/db/package.json && \
    sed -i '' 's/"prisma": "\^5.22.0"/"prisma": "6.19.0"/' packages/db/package.json && \
    sed -i '' 's/"@prisma\/client": "\^5.22.0"/"@prisma\/client": "6.19.0",\n    "@img\/sharp-freebsd-wasm32": "0.35.5"/' apps/api/package.json && \
    node -e 'const fs = require("fs"); const f = "apps/api/src/prisma/prisma.service.ts"; let c = fs.readFileSync(f, "utf8"); c = c.replace(/this\.\$use\(async \(params, next\) => \{[\s\S]*?\}\);\s*\}\n/m, "return this.$extends({ query: { $allModels: { async $allOperations({ model, operation, args, query }: any) { if (model) { const ctx = getTenantContext(); if (ctx) { assertTenantScope({ model, action: operation, args: (args ?? {}) as Record<string, unknown> }, ctx); } } return query(args); } } } }) as any; }\n"); fs.writeFileSync(f, c);' && \
    pnpm install --prod=false && \
    pnpm --filter @weavestream/db prisma:generate && \
    pnpm --filter @weavestream/shared build && \
    pnpm --filter @weavestream/db build && \
    pnpm --filter @weavestream/api build && \
    pnpm --filter @weavestream/worker build && \
    CI=true pnpm install --prod

# ───── runner ─────
FROM ghcr.io/daemonless/base-exec:${BASE_VERSION}

ARG FREEBSD_ARCH=amd64
ARG PACKAGES="node24 prisma-engines postgresql16-client ca_root_nss curl"
ARG UPSTREAM_URL="https://api.github.com/repos/Weavestream/Weavestream/releases/latest"
ARG UPSTREAM_JQ=".tag_name"

LABEL org.opencontainers.image.title="Weavestream Worker" \
      org.opencontainers.image.description="Background queue worker and scheduled task runner for Weavestream, an open-source self-hosted IT documentation and asset management platform." \
      org.opencontainers.image.source="https://github.com/daemonless/weavestream-worker" \
      org.opencontainers.image.url="https://weavestream.io" \
      org.opencontainers.image.documentation="https://docs.weavestream.io" \
      org.opencontainers.image.licenses="AGPL-3.0-or-later" \
      org.opencontainers.image.vendor="daemonless" \
      org.opencontainers.image.authors="daemonless" \
      io.daemonless.category="Productivity" \
      io.daemonless.arch="${FREEBSD_ARCH}" \
      io.daemonless.base="base-exec" \
      io.daemonless.upstream-url="${UPSTREAM_URL}" \
      io.daemonless.upstream-jq="${UPSTREAM_JQ}" \
      io.daemonless.packages="${PACKAGES}"

RUN pkg update && pkg install -y ${PACKAGES} && \
    pkg clean -ay && \
    rm -rf /var/cache/pkg/* /var/db/pkg/repos/* && \
    cp /usr/local/libexec/prisma-engines/libquery_engine.so /usr/local/libexec/prisma-engines/libquery_engine.node

ENV NODE_ENV=production \
    PRISMA_SCHEMA_ENGINE_BINARY="/usr/local/libexec/prisma-engines/schema-engine" \
    PRISMA_QUERY_ENGINE_LIBRARY="/usr/local/libexec/prisma-engines/libquery_engine.node"

WORKDIR /app

COPY --from=builder --chown=bsd:bsd /app/version /app/version
COPY --from=builder --chown=bsd:bsd /repo/node_modules ./node_modules
COPY --from=builder --chown=bsd:bsd /repo/packages/db/node_modules ./packages/db/node_modules
COPY --from=builder --chown=bsd:bsd /repo/packages/shared/node_modules ./packages/shared/node_modules
COPY --from=builder --chown=bsd:bsd /repo/packages/shared/dist ./packages/shared/dist
COPY --from=builder --chown=bsd:bsd /repo/packages/shared/package.json ./packages/shared/package.json
COPY --from=builder --chown=bsd:bsd /repo/packages/db/dist ./packages/db/dist
COPY --from=builder --chown=bsd:bsd /repo/packages/db/package.json ./packages/db/package.json
COPY --from=builder --chown=bsd:bsd /repo/packages/db/prisma ./packages/db/prisma
COPY --from=builder --chown=bsd:bsd /repo/apps/api/dist ./apps/api/dist
COPY --from=builder --chown=bsd:bsd /repo/apps/api/package.json ./apps/api/package.json
COPY --from=builder --chown=bsd:bsd /repo/apps/api/node_modules ./apps/api/node_modules
COPY --from=builder --chown=bsd:bsd /repo/apps/worker/dist ./apps/worker/dist
COPY --from=builder --chown=bsd:bsd /repo/apps/worker/package.json ./apps/worker/package.json
COPY --from=builder --chown=bsd:bsd /repo/apps/worker/node_modules ./apps/worker/node_modules

COPY root/ /

RUN chmod +x /daemonless/libexec/* /daemonless/init.d/* 2>/dev/null || true

WORKDIR /app/apps/worker

CMD ["/daemonless/libexec/weavestream-worker"]